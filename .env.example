# Shiva Electrical & Electronics - Environment Variables Example
# Duplicate this file to .env.local for local development.
# NEVER commit .env.local or sensitive credentials to GitHub.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# 1. NEXT_PUBLIC_SUPABASE_URL
# The REST/GraphQL API endpoint of your Supabase project.
# Found in: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. NEXT_PUBLIC_SUPABASE_ANON_KEY
# The client-safe anonymous API key. Subject to Row Level Security (RLS) policies.
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 3. SUPABASE_SERVICE_ROLE_KEY
# WARNING: Keep this secret! Never expose to browser code or client-side components.
# This key is only loaded in server environments (lib/supabase/admin.ts) with `server-only`.
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# -----------------------------------------------------------------------------
# Site & SEO Configuration
# -----------------------------------------------------------------------------
# The canonical domain of the production or staging website used for metadata,
# OpenGraph social previews, dynamic sitemaps, and crawler directives.
# For local development: http://localhost:3000
# For production: https://shivaelectrical.in (or your Vercel deployment URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
