# Shiva Electrical & Electronics - Environment Variables Example
# Duplicate this file to .env.local for local development.
# NEVER commit .env.local or sensitive credentials to GitHub.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# 1. NEXT_PUBLIC_SUPABASE_URL
# The REST/GraphQL API endpoint of your Supabase project.
# Found in: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. NEXT_PUBLIC_SUPABASE_ANON_KEY
# The client-safe anonymous API key. Subject to Row Level Security (RLS) policies.
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 3. SUPABASE_SERVICE_ROLE_KEY
# WARNING: Keep this secret! Never expose to browser code or client-side components.
# This key is only loaded in server environments (lib/supabase/admin.ts) with `server-only`.
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# -----------------------------------------------------------------------------
# Storage Provider Configuration (Google Drive / Supabase)
# -----------------------------------------------------------------------------
# Active storage provider: 'google_drive' or 'supabase' (defaults to supabase if drive is unconfigured)
STORAGE_PROVIDER=google_drive

# Google Service Account Email (from Google Cloud Console > IAM & Admin > Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com

# Google Service Account Private Key (keep quotes and \n intact)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Drive Target Folder ID (The alphanumeric ID from the Google Drive URL when opening the folder)
# IMPORTANT: Share this folder with your GOOGLE_SERVICE_ACCOUNT_EMAIL with 'Editor' permissions!
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz012345

# -----------------------------------------------------------------------------
# AI Vision Product Scanner Configuration (Optional)
# -----------------------------------------------------------------------------
# Google Gemini API Key for multi-angle OCR and electrical spec extraction.
# Free API key can be obtained from: https://aistudio.google.com/app/apikey
# If omitted, the scanner automatically falls back to your Google Cloud Service Account Vision API.
GEMINI_API_KEY=AQ.Ab8RN6J7pGjCDre5D9BFWxUvtVlHdvOph7ujBEBOyvnA6oOb6w

# -----------------------------------------------------------------------------
# Site & SEO Configuration
# -----------------------------------------------------------------------------
# The canonical domain of the production or staging website used for metadata,
# OpenGraph social previews, dynamic sitemaps, and crawler directives.
# For local development: http://localhost:3000
# For production: https://shivaelectrical.in (or your Vercel deployment URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
